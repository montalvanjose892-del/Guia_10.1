<h1 class="title">Iniciar sesión</h1>

<%= form_with model: resource, scope: resource_name, url: session_path(resource_name), class: "form" do |f| %>
  <div class="field">
    <%= f.label :email, "Correo" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label :password, "Contraseña" %>
    <%= f.password_field :password, autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field check">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "Recordarme" %>
    </div>
  <% end %>

  <div class="center"><%= f.submit "Entrar", class: "btn btn-primary" %></div>
<% end %>

<p class="center"><%= link_to "Registrarse", new_registration_path(resource_name) %></p>
