<h1 class="title">Mi cuenta</h1>

<%= form_with model: resource, scope: resource_name, url: registration_path(resource_name),
              html: { method: :put }, class: "form" do |f| %>
  <%= render "shared/errors", record: resource %>

  <div class="field">
    <%= f.label :username, "Nombre de usuario" %>
    <%= f.text_field :username %>
  </div>

  <div class="field">
    <%= f.label :email, "Correo" %>
    <%= f.email_field :email %>
  </div>

  <div class="field">
    <%= f.label :password, "Nueva contraseña (opcional)" %>
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Confirmar nueva contraseña" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :current_password, "Contraseña actual (obligatoria para guardar)" %>
    <%= f.password_field :current_password, autocomplete: "current-password" %>
  </div>

  <div class="center"><%= f.submit "Guardar cambios", class: "btn btn-primary" %></div>
<% end %>

<hr>
<div class="center">
  <%= button_to "Eliminar mi cuenta", registration_path(resource_name), method: :delete,
                class: "btn btn-danger",
                form: { data: { turbo_confirm: "¿Seguro? Se borrarán también tus publicaciones." } } %>
</div>
