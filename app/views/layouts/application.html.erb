<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Instagram</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="navbar">
      <div class="navbar-inner">
        <%= link_to "Instagram", root_path, class: "brand" %>

        <input type="checkbox" id="nav-toggle" class="nav-toggle">
        <label for="nav-toggle" class="hamburger">&#9776;</label>

        <nav class="nav-links">
          <% if user_signed_in? %>
            <%= link_to "Inicio", root_path %>
            <%= link_to "Nuevo post", new_post_path %>
            <%= link_to "@#{current_user.username}", profile_path(current_user) %>
            <%= link_to "Mi cuenta", edit_user_registration_path %>
            <%= button_to "Cerrar sesión (cambiar usuario)", destroy_user_session_path,
                          method: :delete, class: "link-button" %>
          <% else %>
            <%= link_to "Iniciar sesión", new_user_session_path %>
            <%= link_to "Registrarse", new_user_registration_path %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice.present? %><div class="flash flash-notice"><%= notice %></div><% end %>
    <% if alert.present? %><div class="flash flash-alert"><%= alert %></div><% end %>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
